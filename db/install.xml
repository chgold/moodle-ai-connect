<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/aiconnect/db" VERSION="20261121" COMMENT="XMLDB schema for local_aiconnect (AI Connect WebMCP server)"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_aiconnect_clients" COMMENT="Registered OAuth2 client applications (AI agents) that may request authorization">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="client_id" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Stable client identifier used in OAuth flows"/>
        <FIELD NAME="client_name" TYPE="char" LENGTH="200" NOTNULL="true" SEQUENCE="false" COMMENT="Human readable client name shown on consent screen"/>
        <FIELD NAME="redirect_uris" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Newline separated list of allowed redirect URIs"/>
        <FIELD NAME="scopes" TYPE="char" LENGTH="500" NOTNULL="false" DEFAULT="read write" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="client_id_idx" UNIQUE="true" FIELDS="client_id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_aiconnect_codes" COMMENT="Short lived OAuth2 authorization codes issued during the consent step (PKCE)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="code" TYPE="char" LENGTH="200" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="client_id" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="scope" TYPE="char" LENGTH="500" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="code_challenge" TYPE="char" LENGTH="200" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="redirect_uri" TYPE="char" LENGTH="500" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="expiry" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="used" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="code_idx" UNIQUE="true" FIELDS="code"/>
        <INDEX NAME="userid_idx" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="expiry_idx" UNIQUE="false" FIELDS="expiry"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_aiconnect_tokens" COMMENT="OAuth2 access and refresh tokens">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="token" TYPE="char" LENGTH="200" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="tokentype" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="access | refresh"/>
        <FIELD NAME="client_id" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="scope" TYPE="char" LENGTH="500" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="parenttoken" TYPE="char" LENGTH="200" NOTNULL="false" SEQUENCE="false" COMMENT="For refresh tokens — points to the issued access token"/>
        <FIELD NAME="expiry" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="revoked" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="token_idx" UNIQUE="true" FIELDS="token"/>
        <INDEX NAME="userid_idx" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="expiry_idx" UNIQUE="false" FIELDS="expiry"/>
        <INDEX NAME="tokentype_revoked_idx" UNIQUE="false" FIELDS="tokentype, revoked"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_aiconnect_token_registry" COMMENT="Registry of all issued tokens (audit trail with prefix-only token storage)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="token_prefix" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false" COMMENT="First 16 chars of token only"/>
        <FIELD NAME="user_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="client_id" TYPE="char" LENGTH="80" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="scope" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="issued_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="expires_at" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="last_used_at" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="revoked_at" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="revoked_by" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="source" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="oauth" SEQUENCE="false"/>
        <FIELD NAME="ip_address" TYPE="char" LENGTH="45" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="last_used_ip" TYPE="char" LENGTH="45" NOTNULL="false" SEQUENCE="false" COMMENT="Client IP from last successful API call (IPv6 safe)"/>
        <FIELD NAME="last_used_ua" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="User-Agent string from last successful API call"/>
        <FIELD NAME="refresh_expires_at" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Unix timestamp when the associated refresh token expires"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="token_prefix" UNIQUE="false" FIELDS="token_prefix"/>
        <INDEX NAME="user_id" UNIQUE="false" FIELDS="user_id"/>
        <INDEX NAME="revoked_expires_idx" UNIQUE="false" FIELDS="revoked_at, expires_at"/>
        <INDEX NAME="last_used_at_idx" UNIQUE="false" FIELDS="last_used_at"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_aiconnect_ratelimits" COMMENT="Per token rate limit counters bucketed by minute and hour windows">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="token" TYPE="char" LENGTH="200" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="windowtype" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="minute | hour"/>
        <FIELD NAME="windowstart" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="requestcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="token_window_idx" UNIQUE="true" FIELDS="token, windowtype"/>
        <INDEX NAME="windowstart_idx" UNIQUE="false" FIELDS="windowstart"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_aiconnect_blocked" COMMENT="Users blocked by an admin from accessing the AI Connect API">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user id that is blocked"/>
        <FIELD NAME="blockedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Admin user id who performed the block"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_idx" UNIQUE="true" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_aiconnect_pending" COMMENT="Actions an AI agent asked for that wait for the user's confirmation (user-confirm-v1)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="confid" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Public confirmation id conf_ + 32 hex"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Token owner who must confirm"/>
        <FIELD NAME="tool" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="argsjson" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Canonical arguments that will run"/>
        <FIELD NAME="argshash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="SHA-256 of the canonical arguments"/>
        <FIELD NAME="clientkey" TYPE="char" LENGTH="120" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="clientid" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="scope" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tokenprefix" TYPE="char" LENGTH="16" NOTNULL="false" SEQUENCE="false" COMMENT="Prefix of the token that asked (revocation check)"/>
        <FIELD NAME="risk" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="destructive" SEQUENCE="false"/>
        <FIELD NAME="summary" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="One sentence for the user, in their language"/>
        <FIELD NAME="details" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON list of plain lines: what will happen"/>
        <FIELD NAME="previewjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lang" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, executing, executed, failed, rejected, expired"/>
        <FIELD NAME="claim" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false" COMMENT="Single-use claim of the deciding request"/>
        <FIELD NAME="resultjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="expiresat" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timedecided" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="decidedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timeexecuted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timedelivered" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="When the agent collected the result"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="confid_idx" UNIQUE="true" FIELDS="confid"/>
        <INDEX NAME="user_status_idx" UNIQUE="false" FIELDS="userid, status"/>
        <INDEX NAME="lookup_idx" UNIQUE="false" FIELDS="userid, tool, argshash"/>
        <INDEX NAME="status_expires_idx" UNIQUE="false" FIELDS="status, expiresat"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_aiconnect_autonomy" COMMENT="A user let one AI client run one confirmation tool without asking">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="tool" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="clientid" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="via" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="user_tool_client_idx" UNIQUE="true" FIELDS="userid, tool, clientid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_aiconnect_conflog" COMMENT="Append-only audit log of the confirmation flow">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="confid" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="event" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Owner of the action"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Who caused the event"/>
        <FIELD NAME="tool" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="clientid" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="ip" TYPE="char" LENGTH="45" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="detail" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_idx" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="confid_idx" UNIQUE="false" FIELDS="confid"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
